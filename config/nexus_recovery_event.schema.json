{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nexus.recovery-event.v1",
  "title": "Nexus Recovery Event",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "event_id", "occurred_at", "objective_id", "department", "job_type", "current_state", "expected_state", "failed_transition", "error_code", "attempt_count", "available_capabilities", "authorized_actions", "prohibited_actions", "cost_boundary", "evidence_references", "objective_termination_authorized"],
  "properties": {
    "schema_version": {"const": "nexus.recovery-event.v1"},
    "event_id": {"type": "string", "minLength": 1},
    "occurred_at": {"type": "string", "format": "date-time"},
    "objective_id": {"type": ["string", "null"], "minLength": 1},
    "project_id": {"type": ["string", "null"]},
    "job_id": {"type": ["string", "null"]},
    "case_id": {"type": ["string", "null"]},
    "department": {"type": "string", "minLength": 1},
    "job_type": {"type": "string", "minLength": 1},
    "failure_domain": {"type": ["string", "null"]},
    "current_state": {"type": "string", "minLength": 1},
    "expected_state": {"type": "string", "minLength": 1},
    "last_successful_transition": {"type": ["string", "null"]},
    "failed_transition": {"type": "string", "minLength": 1},
    "error_code": {"type": "string", "minLength": 1},
    "error_summary": {"type": "string", "maxLength": 1000},
    "attempt_count": {"type": "integer", "minimum": 0},
    "recent_attempts": {"type": "array", "items": {"type": "object"}},
    "available_capabilities": {"type": "array", "items": {"type": "string"}},
    "authorized_actions": {"type": "array", "items": {"type": "string"}},
    "prohibited_actions": {"type": "array", "items": {"type": "string"}},
    "cost_boundary": {"type": "object", "required": ["incremental_spend_authorized", "max_incremental_cost"], "properties": {"incremental_spend_authorized": {"const": false}, "max_incremental_cost": {"const": 0}}, "additionalProperties": true},
    "evidence_references": {"type": "array", "items": {"type": "string"}},
    "relevant_self_knowledge": {"type": "array", "items": {"type": "string"}},
    "objective_termination_authorized": {"const": false}
  }
}
