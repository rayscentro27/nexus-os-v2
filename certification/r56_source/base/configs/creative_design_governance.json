    "spacing",
    "typography",
    "colors",
    "components",
    "icon_specs",
    "layout_dimensions",
    "responsive_rules",
    "asset_references",
    "interaction_rules",
    "do_not_change_rules",
    "approved_artifact_url",
    "ray_approval_receipt"
  ],
  "admin_command_center_artifact_status": "creative_artifact_required",
  "admin_command_center_implementation_status": "not_started"
}
