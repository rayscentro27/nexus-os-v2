[Unit]
Description=Nexus Trading Core R1 bounded cycle (OANDA Practice, observe-only)
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/nexus-app-services/trading
# oneshot + timer => never overlaps; hard timeout bounds a hung broker call
TimeoutStartSec=300
ExecStart=/usr/bin/docker compose run --rm --no-deps trading-cycle
Nice=10
