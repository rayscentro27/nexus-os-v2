      "provider_compatibility": ["kaggle", "oracle", "modal"],
      "required_accelerator": "GPU_OPTIONAL",
      "base_runtime": "python:3.11",
      "python_packages": ["torch==2.2.2", "packaging==24.2"],
      "system_packages": ["ffmpeg"],
      "model_revision": null,
      "inputs": [],
      "outputs": ["diagnostic_report.json", "run_manifest.json"],
      "resource_class": "small_gpu_or_cpu",
      "validation": ["python version", "torch import", "CUDA availability", "ffmpeg version", "disk", "network status", "model import boundary"],
      "reproducibility_status": "READY"
    },
    {
